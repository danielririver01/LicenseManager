[Unit]
Description=Programa el respaldo diario de License Manager
Documentation=file:/opt/license-manager/deploy/README.md

[Timer]
# 03:30 UTC (fuera del horario de caja en Colombia).
OnCalendar=*-*-* 03:30:00 UTC
# Si el VPS estuvo apagado a esa hora, corre al arrancar.
Persistent=true
# Hasta 15 minutos de desfase para no chocar con otros trabajos.
RandomizedDelaySec=900
Unit=license-manager-backup.service

[Install]
WantedBy=timers.target
