# License Manager - variables de entorno de PRODUCCION (VPS Linux).
#
# Ubicacion en el servidor: /etc/license-manager/license-manager.env
# Permisos: 640 y dueno root:license-manager (nunca en el repositorio).
#
# Copia este archivo, rellena los valores y protegelo:
#   sudo install -m 640 -o root -g license-manager \
#     deploy/env.production.example /etc/license-manager/license-manager.env

# --- Base de datos -----------------------------------------------------------
# PostgreSQL gestionado en el propio VPS.
LM_DATABASE_URL=postgresql+psycopg://license_manager:CLAVE_FUERTE@127.0.0.1:5432/license_manager

# --- Custodia de la llave privada ECDSA P-256 --------------------------------
# La llave NUNCA va en el repositorio. Se sube al servidor con scp y se deja
# con permisos 600 del usuario del servicio.
LM_ECDSA_PRIVATE_KEY_FILE=/etc/license-manager/private.pem
# keyId que Frubber POS ya trae embebido: si no coincide, el POS rechaza TODO.
LM_EXPECTED_KEY_ID=lic-v1-2026-09-29

# --- Sesiones ---------------------------------------------------------------
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LM_SESSION_SECRET=REEMPLAZA-CON-UN-VALOR-LARGO-ALEATORIO
LM_SESSION_MAX_AGE_SECONDS=43200
# Obligatorio True detras de TLS: la cookie solo viaja por HTTPS.
LM_COOKIE_SECURE=true

# --- Seguridad --------------------------------------------------------------
# Solo con TLS ya funcionando (Caddy lo pone solo con el dominio real).
LM_ENABLE_HSTS=true
# Dominio real del sitio; deja * solo si no puedes fijarlo.
LM_TRUSTED_HOSTS=license-manager.tu-dominio.com

# --- Entorno ----------------------------------------------------------------
LM_ENVIRONMENT=production
LM_DEBUG=false

# --- Respaldos (lo lee el temporizador de systemd) ---------------------------
LM_BACKUP_DIR=/var/backups/license-manager
LM_BACKUP_KEEP=14
# Comando opcional de subida a la nube; {file} se sustituye por el respaldo.
# Ejemplos (instala antes rclone): rclone copy {file} b2:frubber-backups
# LM_BACKUP_UPLOAD=rclone copy {file} b2:frubber-backups
