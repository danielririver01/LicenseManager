# License Manager - variables de entorno de DESARROLLO.
# Copia este archivo como .env y rellena los valores reales en el servidor.
# NUNCA subas el .env al repositorio.

# --- Base de datos -----------------------------------------------------------
# Produccion (VPS Linux):
LM_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/license_manager
# Desarrollo local (sin instalar PostgreSQL):
# LM_DATABASE_URL=sqlite:///./license_manager.db

# --- Custodia de la llave privada ECDSA P-256 --------------------------------
# Opcion A: la llave en una variable de entorno (usa \n para los saltos).
# LM_ECDSA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Opcion B: la llave en un archivo con permisos restringidos (recomendado).
LM_ECDSA_PRIVATE_KEY_FILE=.dev-private.pem

# keyId que Frubber POS reconoce. Debe coincidir con
# LicensePublicKeys.CurrentKeyId en el POS.
LM_EXPECTED_KEY_ID=lic-v1-2026-09-29

# --- Sesiones ---------------------------------------------------------------
LM_SESSION_SECRET=REEMPLAZA-ESTO-CON-UN-VALOR-LARGO-ALEATORIO
LM_SESSION_MAX_AGE_SECONDS=43200
# En produccion True. Solo bajalo a False para desarrollo local por HTTP.
LM_COOKIE_SECURE=false

# --- Seguridad --------------------------------------------------------------
# Solo en produccion, detras de TLS.
LM_ENABLE_HSTS=false
LM_TRUSTED_HOSTS=*

# --- Entorno ----------------------------------------------------------------
LM_ENVIRONMENT=development
LM_DEBUG=false
